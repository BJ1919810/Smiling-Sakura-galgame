{
  "name": "xiaoying-galgame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "《笑樱》—— 自研引擎 Galgame（篠宫樱 单线）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "compile": "node --experimental-strip-types tools/compiler/index.ts",
    "play": "node --experimental-strip-types tools/compiler/play.ts",
    "manifest": "node --experimental-strip-types tools/compiler/manifest.ts",
    "posesplit": "node --experimental-strip-types tools/compiler/pose-split.ts",
    "rhythm": "node --experimental-strip-types tools/compiler/rhythm.ts",
    "shot": "node --experimental-strip-types tools/shot.ts",
    "diag:frame": "node --experimental-strip-types tools/diag-frame.ts",
    "diag:hop": "node --experimental-strip-types tools/diag-hop.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "gsap": "^3.12.0",
    "idb-keyval": "^6.2.0",
    "pixi.js": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.63.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
