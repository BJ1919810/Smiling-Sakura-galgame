{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "笑樱",
  "version": "0.2.0",
  "identifier": "com.qingyu.xiaoying",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "笑樱",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 576,
        "center": true,
        "resizable": true,
        "backgroundColor": "#12101A"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
